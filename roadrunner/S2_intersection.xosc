<?xml version="1.0" encoding="UTF-8"?>
<!-- S2: unmarked 4-way junction; auto crosses t=5 s, bike t=7 s (no right of way). -->
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <FileHeader revMajor="1" revMinor="0" date="2026-09-09" description="S2 unsignalized urban intersection" author="TriFusion SIH"/>
  <CatalogLocations/>
  <RoadNetwork>
    <LogicFile filepath="S2_intersection.xodr"/>
    <SceneGraphFile filepath=""/>
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <Vehicle name="EgoCar" vehicleCategory="car" mass="1500.0">
        <ParameterDeclarations/>
        <Performance maxSpeed="15.0" maxAcceleration="3.0" maxDeceleration="6.0"/>
        <BoundingBox><Center x="1.4" y="0.0" z="0.9"/><Dimensions width="1.7" length="4.2" height="1.8"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.6" positionX="1.4" positionZ="0.3"/>
        <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.6" positionX="-1.4" positionZ="0.3"/></Axles>
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="AutoCross">
      <Vehicle name="Auto" vehicleCategory="three-wheeler" mass="600.0">
        <ParameterDeclarations/>
        <Performance maxSpeed="12.0" maxAcceleration="2.5" maxDeceleration="5.0"/>
        <BoundingBox><Center x="1.0" y="0.0" z="0.9"/><Dimensions width="1.4" length="3.0" height="1.8"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.5" wheelDiameter="0.5" trackWidth="1.2" positionX="1.0" positionZ="0.25"/>
        <RearAxle maxSteering="0.0" wheelDiameter="0.5" trackWidth="1.2" positionX="-1.0" positionZ="0.25"/></Axles>
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="BikeCross">
      <Vehicle name="Bike" vehicleCategory="motorbike" mass="250.0">
        <ParameterDeclarations/>
        <Performance maxSpeed="16.0" maxAcceleration="4.0" maxDeceleration="6.0"/>
        <BoundingBox><Center x="0.6" y="0.0" z="0.6"/><Dimensions width="0.7" length="2.0" height="1.4"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.5" wheelDiameter="0.5" trackWidth="0.5" positionX="0.7" positionZ="0.25"/>
        <RearAxle maxSteering="0.0" wheelDiameter="0.5" trackWidth="0.5" positionX="-0.7" positionZ="0.25"/></Axles>
      </Vehicle>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego"><PrivateAction>
          <TeleportAction><Position><LanePosition roadId="1" laneId="-1" offset="0.0" s="0.0"/></Position></TeleportAction>
        </PrivateAction></Private>
        <Private entityRef="Ego"><PrivateAction>
          <LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="5.0" dynamicsDimension="time"/>
          <SpeedActionTarget><AbsoluteTargetSpeed value="5.0"/></SpeedActionTarget></SpeedAction></LongitudinalAction>
        </PrivateAction></Private>
        <Private entityRef="AutoCross"><PrivateAction>
          <TeleportAction><Position><WorldPosition x="-30.0" y="100.0" z="0.0" h="1.57"/></Position></TeleportAction>
        </PrivateAction></Private>
        <Private entityRef="BikeCross"><PrivateAction>
          <TeleportAction><Position><WorldPosition x="30.0" y="104.0" z="0.0" h="-1.57"/></Position></TeleportAction>
        </PrivateAction></Private>
      </Actions>
    </Init>
    <Story name="ErraticCrossing">
      <Act name="Crossings">
        <ManeuverGroup maximumExecutionCount="1" name="AutoMG">
          <Actors selectTriggeringEntities="false"><EntityRef entityRef="AutoCross"/></Actors>
          <Maneuver name="AutoGo">
            <Event name="AtT5" priority="overwrite">
              <Action name="Drive" xsi:type="PrivateAction"><PrivateAction>
                <LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="linear" value="2.0" dynamicsDimension="time"/>
                <SpeedActionTarget><AbsoluteTargetSpeed value="5.0"/></SpeedActionTarget></SpeedAction></LongitudinalAction>
              </PrivateAction></Action>
              <StartTrigger><ConditionGroup><Condition name="T5" delay="0" conditionEdge="rising">
                <ByValueCondition><SimulationTimeCondition value="5.0" rule="greaterThan"/></ByValueCondition>
              </Condition></ConditionGroup></StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <ManeuverGroup maximumExecutionCount="1" name="BikeMG">
          <Actors selectTriggeringEntities="false"><EntityRef entityRef="BikeCross"/></Actors>
          <Maneuver name="BikeGo">
            <Event name="AtT7" priority="overwrite">
              <Action name="Drive" xsi:type="PrivateAction"><PrivateAction>
                <LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="linear" value="2.0" dynamicsDimension="time"/>
                <SpeedActionTarget><AbsoluteTargetSpeed value="6.0"/></SpeedActionTarget></SpeedAction></LongitudinalAction>
              </PrivateAction></Action>
              <StartTrigger><ConditionGroup><Condition name="T7" delay="0" conditionEdge="rising">
                <ByValueCondition><SimulationTimeCondition value="7.0" rule="greaterThan"/></ByValueCondition>
              </Condition></ConditionGroup></StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger><ConditionGroup><Condition name="Go" delay="0" conditionEdge="rising">
          <ByValueCondition><SimulationTimeCondition value="0.0" rule="greaterThan"/></ByValueCondition>
        </Condition></ConditionGroup></StartTrigger>
      </Act>
      <StopTrigger><ConditionGroup><Condition name="End" delay="0" conditionEdge="rising">
        <ByValueCondition><SimulationTimeCondition value="90.0" rule="greaterThan"/></ByValueCondition>
      </Condition></ConditionGroup></StopTrigger>
    </Story>
  </Storyboard>
</OpenSCENARIO>
