<?xml version="1.0" encoding="UTF-8"?>
<!-- S4: vendor cart pulls out t=10 s; pedestrians cross t=12/14 s. Crawl zone. -->
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <FileHeader revMajor="1" revMinor="0" date="2026-09-09" description="S4 dense market shared space" author="TriFusion SIH"/>
  <CatalogLocations/>
  <RoadNetwork>
    <LogicFile filepath="S4_market.xodr"/>
    <SceneGraphFile filepath=""/>
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <Vehicle name="EgoCar" vehicleCategory="car" mass="1500.0">
        <ParameterDeclarations/>
        <Performance maxSpeed="8.0" maxAcceleration="2.0" maxDeceleration="6.0"/>
        <BoundingBox><Center x="1.4" y="0.0" z="0.9"/><Dimensions width="1.7" length="4.2" height="1.8"/></BoundingBox>
        <Axles><FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.6" positionX="1.4" positionZ="0.3"/>
        <RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.6" positionX="-1.4" positionZ="0.3"/></Axles>
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="Cart">
      <MiscObject name="VendorCart" mass="200.0" miscObjectCategory="obstacle">
        <ParameterDeclarations/>
        <BoundingBox><Center x="0.0" y="0.0" z="0.8"/><Dimensions width="1.6" length="2.4" height="1.6"/></BoundingBox>
      </MiscObject>
    </ScenarioObject>
    <ScenarioObject name="Ped1">
      <Pedestrian name="Shopper1" mass="70.0" model="adult" pedestrianCategory="pedestrian">
        <ParameterDeclarations/>
        <BoundingBox><Center x="0.0" y="0.0" z="0.9"/><Dimensions width="0.6" length="0.6" height="1.8"/></BoundingBox>
      </Pedestrian>
    </ScenarioObject>
    <ScenarioObject name="Ped2">
      <Pedestrian name="Shopper2" mass="70.0" model="adult" pedestrianCategory="pedestrian">
        <ParameterDeclarations/>
        <BoundingBox><Center x="0.0" y="0.0" z="0.9"/><Dimensions width="0.6" length="0.6" height="1.8"/></BoundingBox>
      </Pedestrian>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego"><PrivateAction>
          <TeleportAction><Position><LanePosition roadId="1" laneId="-1" offset="0.0" s="0.0"/></Position></TeleportAction>
        </PrivateAction></Private>
        <Private entityRef="Ego"><PrivateAction>
          <LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="step" value="3.0" dynamicsDimension="time"/>
          <SpeedActionTarget><AbsoluteTargetSpeed value="3.0"/></SpeedActionTarget></SpeedAction></LongitudinalAction>
        </PrivateAction></Private>
        <Private entityRef="Cart"><PrivateAction>
          <TeleportAction><Position><WorldPosition x="4.2" y="110.0" z="0.0" h="-1.57"/></Position></TeleportAction>
        </PrivateAction></Private>
        <Private entityRef="Ped1"><PrivateAction>
          <TeleportAction><Position><WorldPosition x="-4.0" y="120.0" z="0.0" h="1.57"/></Position></TeleportAction>
        </PrivateAction></Private>
        <Private entityRef="Ped2"><PrivateAction>
          <TeleportAction><Position><WorldPosition x="4.0" y="135.0" z="0.0" h="-1.57"/></Position></TeleportAction>
        </PrivateAction></Private>
      </Actions>
    </Init>
    <Story name="MarketChaos">
      <Act name="Chaos">
        <ManeuverGroup maximumExecutionCount="1" name="CartMG">
          <Actors selectTriggeringEntities="false"><EntityRef entityRef="Cart"/></Actors>
          <Maneuver name="Pullout">
            <Event name="AtT10" priority="overwrite">
              <Action name="Roll" xsi:type="PrivateAction"><PrivateAction>
                <LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="linear" value="2.0" dynamicsDimension="time"/>
                <SpeedActionTarget><AbsoluteTargetSpeed value="1.0"/></SpeedActionTarget></SpeedAction></LongitudinalAction>
              </PrivateAction></Action>
              <StartTrigger><ConditionGroup><Condition name="T10" delay="0" conditionEdge="rising">
                <ByValueCondition><SimulationTimeCondition value="10.0" rule="greaterThan"/></ByValueCondition>
              </Condition></ConditionGroup></StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <ManeuverGroup maximumExecutionCount="1" name="PedMG">
          <Actors selectTriggeringEntities="false"><EntityRef entityRef="Ped1"/><EntityRef entityRef="Ped2"/></Actors>
          <Maneuver name="Crossings">
            <Event name="AtT12" priority="overwrite">
              <Action name="Walk1" xsi:type="PrivateAction"><PrivateAction>
                <LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="linear" value="1.0" dynamicsDimension="time"/>
                <SpeedActionTarget><AbsoluteTargetSpeed value="1.0"/></SpeedActionTarget></SpeedAction></LongitudinalAction>
              </PrivateAction></Action>
              <StartTrigger><ConditionGroup><Condition name="T12" delay="0" conditionEdge="rising">
                <ByValueCondition><SimulationTimeCondition value="12.0" rule="greaterThan"/></ByValueCondition>
              </Condition></ConditionGroup></StartTrigger>
            </Event>
            <Event name="AtT14" priority="overwrite">
              <Action name="Walk2" xsi:type="PrivateAction"><PrivateAction>
                <LongitudinalAction><SpeedAction><SpeedActionDynamics dynamicsShape="linear" value="1.0" dynamicsDimension="time"/>
                <SpeedActionTarget><AbsoluteTargetSpeed value="1.2"/></SpeedActionTarget></SpeedAction></LongitudinalAction>
              </PrivateAction></Action>
              <StartTrigger><ConditionGroup><Condition name="T14" delay="0" conditionEdge="rising">
                <ByValueCondition><SimulationTimeCondition value="14.0" rule="greaterThan"/></ByValueCondition>
              </Condition></ConditionGroup></StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger><ConditionGroup><Condition name="Go" delay="0" conditionEdge="rising">
          <ByValueCondition><SimulationTimeCondition value="0.0" rule="greaterThan"/></ByValueCondition>
        </Condition></ConditionGroup></StartTrigger>
      </Act>
      <StopTrigger><ConditionGroup><Condition name="End" delay="0" conditionEdge="rising">
        <ByValueCondition><SimulationTimeCondition value="150.0" rule="greaterThan"/></ByValueCondition>
      </Condition></ConditionGroup></StopTrigger>
    </Story>
  </Storyboard>
</OpenSCENARIO>
